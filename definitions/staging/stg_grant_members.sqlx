config {
  type: "table",
  name: "stg_grant_members",
  tags: ["helpdesk"],
  description: "Active regular members of the Lesko grant community (anyone in stg_grant_team_members excluded — MN hosts/moderators plus hand-added overrides). Only fields needed by the helpdesk dashboard."
}

SELECT
  member_id,
  first_name,
  last_name,
  CONCAT(
    COALESCE(first_name, ''),
    ' ',
    COALESCE(last_name, '')
  )                       AS full_name,
  email_address,
  state,
  city,
  country,
  member_status,
  avatar_url,
  join_date,
  last_visited_network,
  permalink               AS member_permalink

FROM ${ref("core_members")}

WHERE client_id  = 'lesko_4022250'
  AND member_id NOT IN (SELECT member_id FROM ${ref("stg_grant_team_members")})
  AND member_id NOT IN (
    SELECT member_id FROM ${ref("info_avatars")} WHERE client_id = 'lesko_4022250'
  )
