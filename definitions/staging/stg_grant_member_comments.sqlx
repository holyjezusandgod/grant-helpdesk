config {
  type: "incremental",
  name: "stg_grant_member_comments",
  uniqueKey: ["content_id"],
  bigquery: { partitionBy: "DATE(created_at)" },
  tags: ["helpdesk"],
  description: "Active comments on Lesko grant posts, team included. HTML stripped. Team/avatar exclusion and thread-root ranking both happen downstream in stg_grant_candidates."
}

-- Append-only: row-local work only. See the note in stg_grant_posts.sqlx.
--
-- member_thread_rank USED TO BE COMPUTED HERE and was wrong for exactly that reason:
-- a window function inside an incremental model only sees the rows in the current
-- batch, so a member's second comment on a post arrived in a later run, found an
-- empty partition, and was ranked 1 again — opening a duplicate ticket instead of
-- joining the existing thread. It now lives in stg_grant_candidates, where the
-- window spans the whole table on every run.

SELECT
  CONCAT('comment_', CAST(comment_id AS STRING))       AS content_id,
  CONCAT('post_',    CAST(targetable_id AS STRING))    AS thread_id,
  'comment'                                             AS content_type,
  author_id                                             AS member_id,
  space_id,
  CAST(NULL AS STRING)                               AS title,
  TRIM(REGEXP_REPLACE(
    REGEXP_REPLACE(comment_text, r'<[^>]+>', ' '),
    r'\s+', ' '
  ))                                                 AS body,
  permalink,
  created_at,
  updated_at,
  created_at                                         AS last_activity_at,

  -- thread detection fields (row-local, so they stay)
  depth,
  reply_to_id,

  -- Ingestion timestamp: the incremental watermark keys on this, not on created_at.
  received_at

FROM ${ref("core_comments")}

WHERE client_id        = 'lesko_4022250'
  AND comment_status   = 'active'
  AND targetable_type  = 'Post'
  ${ when(incremental(), `AND received_at > TIMESTAMP_SUB(
       (SELECT MAX(received_at) FROM ${self()}), INTERVAL 1 HOUR)`) }
