config {
  type: "incremental",
  name: "stg_grant_articles",
  uniqueKey: ["content_id"],
  bigquery: { partitionBy: "DATE(created_at)" },
  tags: ["helpdesk"],
  description: "Active articles from the Lesko grant community, team included. HTML stripped from body. Prefixed content_id to avoid collision with posts. Team/avatar exclusion happens downstream in stg_grant_candidates."
}

-- Append-only: row-local work only. See the note in stg_grant_posts.sqlx.

SELECT
  CONCAT('article_', CAST(article_id AS STRING))  AS content_id,
  CONCAT('article_', CAST(article_id AS STRING))  AS thread_id,
  'article'                                         AS content_type,
  creator_id                                        AS member_id,
  space_id,
  title,
  TRIM(REGEXP_REPLACE(
    REGEXP_REPLACE(description, r'<[^>]+>', ' '),
    r'\s+', ' '
  ))                                                AS body,
  permalink,
  created_at,
  updated_at,
  last_activity_at,

  -- Ingestion timestamp: the incremental watermark keys on this, not on created_at.
  received_at

FROM ${ref("core_articles")}

WHERE client_id      = 'lesko_4022250'
  AND article_status = 'active'
  ${ when(incremental(), `AND received_at > TIMESTAMP_SUB(
       (SELECT MAX(received_at) FROM ${self()}), INTERVAL 1 HOUR)`) }
