config {
  type: "table",
  name: "grant_tickets",
  tags: ["helpdesk"],
  description: "Main view for the grant helpdesk dashboard. ticket_status = manual override from ticket_metadata if set, else 'open' (or 'not_a_question' when the classifier rejects it). Lifecycle is open vs terminal (closed/cancelled/not_a_question); assignment is separate (assigned_to)."
}

-- All member activity per thread (includes depth-2 replies and rank>1 depth-1 comments from same member).
-- Used to detect if a member replied after a thread was closed → triggers auto-reopen.
-- Also drives the needs_attention flag (member replied after team engaged).
WITH member_activity AS (
  SELECT
    CASE
      WHEN cc.targetable_type = 'Post'    THEN CONCAT('post_',    CAST(cc.targetable_id AS STRING))
      WHEN cc.targetable_type = 'Article' THEN CONCAT('article_', CAST(cc.targetable_id AS STRING))
    END                AS thread_id,
    cc.author_id       AS member_id,
    MAX(cc.created_at) AS last_member_activity_at
  FROM ${ref("core_comments")} cc
  WHERE cc.client_id      = 'lesko_4022250'
    AND cc.comment_status = 'active'
    AND cc.author_id NOT IN (
      SELECT member_id FROM ${ref("core_members")}
      WHERE client_id = 'lesko_4022250' AND network_role IN ('host', 'moderator')
    )
    AND cc.author_id NOT IN (
      SELECT member_id FROM ${ref("info_avatars")} WHERE client_id = 'lesko_4022250'
    )
  GROUP BY 1, 2
)

SELECT
  c.content_id,
  c.thread_id,
  c.content_type,
  c.space_id,
  c.title,
  c.body,
  c.permalink,
  c.created_at,
  c.updated_at,
  c.last_activity_at,

  -- member fields (stg_grant_members for regular members; core_members fallback for hosts/moderators)
  c.member_id,
  COALESCE(m.full_name, CONCAT(COALESCE(cm.first_name, ''), ' ', COALESCE(cm.last_name, ''))) AS member_name,
  COALESCE(m.first_name,    cm.first_name)    AS first_name,
  COALESCE(m.last_name,     cm.last_name)     AS last_name,
  COALESCE(m.email_address, cm.email_address) AS email_address,
  COALESCE(m.state,         cm.state)         AS member_state,
  COALESCE(m.city,          cm.city)          AS member_city,
  COALESCE(m.avatar_url,    cm.avatar_url)    AS avatar_url,
  COALESCE(m.join_date,     cm.join_date)     AS join_date,
  COALESCE(m.last_visited_network, cm.last_visited_network) AS last_visited_network,
  COALESCE(m.member_permalink,     cm.permalink)            AS member_permalink,

  -- team engagement signals (display only — no longer used to derive ticket_status)
  COALESCE(te.team_commented,        FALSE) AS team_commented,
  COALESCE(te.team_comment_replied,  FALSE) AS team_comment_replied,
  COALESCE(te.team_reacted,          FALSE) AS team_reacted,
  te.first_engagement_at,

  -- thread activity: latest member comment/reply across all depths
  ma.last_member_activity_at,

  -- needs_attention: member replied after the team first engaged (thread may need follow-up)
  COALESCE(ma.last_member_activity_at > te.first_engagement_at, FALSE) AS needs_attention,

  -- ticket status — explicit coach actions only:
  -- (1) closed but member replied since → auto-reopen
  -- (2) closed and no new member activity → closed
  -- (3) any other manual status → use it
  -- (4) classifier rejected → not_a_question
  -- (5) default → open
  CASE
    WHEN t.status = 'closed'
     AND ma.last_member_activity_at > t.closed_at  THEN 'open'
    WHEN t.status = 'closed'                        THEN 'closed'
    WHEN t.status IS NOT NULL                       THEN t.status
    WHEN c.is_question = FALSE                      THEN 'not_a_question'
    ELSE                                                 'open'
  END                                               AS ticket_status,

  t.status                                          AS manual_status,
  t.closed_at,
  t.closed_by,
  COALESCE(t.assigned_to, mas.assigned_to)          AS assigned_to,
  t.updated_at                                      AS ticket_updated_at,

  -- AI-derived domain label; manual value in ticket_metadata takes precedence
  COALESCE(t.domain, ai.domain) AS domain

FROM ${ref("grant_content")} c

LEFT JOIN ${ref("stg_grant_members")} m
  ON c.member_id = m.member_id

LEFT JOIN ${ref("core_members")} cm
  ON c.member_id = cm.member_id
 AND cm.client_id = 'lesko_4022250'

LEFT JOIN ${ref("stg_team_engagement")} te
  ON c.content_id = te.content_id

LEFT JOIN ${ref("ticket_metadata")} t
  ON c.content_id = t.content_id

LEFT JOIN ${ref("grant_ticket_labels")} ai
  ON c.content_id = ai.content_id

LEFT JOIN ${ref("grant_member_assignments")} mas
  ON c.member_id = mas.member_id

LEFT JOIN member_activity ma
  ON c.thread_id = ma.thread_id
 AND c.member_id = ma.member_id
